Package: PscanRBackgrounds
Type: Package
Title: Precomputed Promoter Backgrounds for PscanR
Version: 0.99.0
Authors@R: c(
    person("Federico", "Zambelli",
        email = "federico.zambelli@unimi.it",
        role = c("aut", "cre"),
